#include <ESP8266WiFi.h>
#include <PubSubClient.h>
#include <SoftwareSerial.h>

// =====================================================
// WIFI
// =====================================================
const char* WIFI_SSID = "ritika gupta";
const char* WIFI_PASSWORD = "g8j2x7fc";

// =====================================================
// MQTT
// =====================================================
const char* MQTT_BROKER = "10.98.170.126";
const int MQTT_PORT = 1883;

const char* MQTT_TOPIC = "roadsos/fpga/data";

// =====================================================
// ESP1 ↔ FPGA1 UART
// D5 = RX  ← FPGA1 A14 TX
// D6 = TX  → FPGA1 C14 RX
// =====================================================
SoftwareSerial fpgaSerial(D5, D6);

// =====================================================
// MQTT OBJECTS
// =====================================================
WiFiClient espClient;
PubSubClient mqttClient(espClient);

// =====================================================
// WIFI
// =====================================================
void setupWiFi()
{
  Serial.println();
  Serial.println("================================");
  Serial.println("       ESP1 MQTT PUBLISHER");
  Serial.println("================================");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to Wi-Fi");

  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WIFI CONNECTED!");

  Serial.print("ESP1 IP: ");
  Serial.println(WiFi.localIP());

  Serial.print("Signal: ");
  Serial.print(WiFi.RSSI());
  Serial.println(" dBm");
}

// =====================================================
// MQTT CONNECT
// =====================================================
void connectMQTT()
{
  while (!mqttClient.connected())
  {
    Serial.println();
    Serial.println("Connecting to MQTT broker...");

    String clientID = "ESP1_PUBLISHER_";
    clientID += String(ESP.getChipId(), HEX);

    if (mqttClient.connect(clientID.c_str()))
    {
      Serial.println("MQTT CONNECTED!");

      Serial.print("Broker: ");
      Serial.println(MQTT_BROKER);

      Serial.print("Port: ");
      Serial.println(MQTT_PORT);

      Serial.print("Topic: ");
      Serial.println(MQTT_TOPIC);
    }
    else
    {
      Serial.print("MQTT FAILED | State: ");
      Serial.println(mqttClient.state());

      delay(1000);
    }
  }
}

// =====================================================
// SETUP
// =====================================================
void setup()
{
  // USB Serial Monitor
  Serial.begin(115200);

  // FPGA UART
  fpgaSerial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("        ESP1 STARTING");
  Serial.println("================================");

  Serial.println("FPGA UART:");
  Serial.println("D5 = RX");
  Serial.println("D6 = TX");

  setupWiFi();

  mqttClient.setServer(MQTT_BROKER, MQTT_PORT);

  connectMQTT();

  Serial.println();
  Serial.println("================================");
  Serial.println("ESP1 READY");
  Serial.println("Waiting for FPGA1 data...");
  Serial.println("================================");
}

// =====================================================
// LOOP
// =====================================================
void loop()
{
  // -----------------------------------------
  // Wi-Fi
  // -----------------------------------------
  if (WiFi.status() != WL_CONNECTED)
  {
    setupWiFi();
  }

  // -----------------------------------------
  // MQTT
  // -----------------------------------------
  if (!mqttClient.connected())
  {
    connectMQTT();
  }

  mqttClient.loop();

  // -----------------------------------------
  // FPGA1 → ESP1 → MQTT
  // -----------------------------------------
  while (fpgaSerial.available())
  {
    byte data = fpgaSerial.read();

    Serial.print("FPGA1 -> MQTT: ");

    if (data < 0x10)
      Serial.print("0");

    Serial.println(data, HEX);

    bool success = mqttClient.publish(
      MQTT_TOPIC,
      &data,
      1,
      false
    );

    if (success)
    {
      Serial.println("MQTT PUBLISHED");
    }
    else
    {
      Serial.println("MQTT PUBLISH FAILED");
    }
  }
}
